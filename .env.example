# Browser-visible. This is the only variable intentionally included in the Vite bundle.
VITE_TURNSTILE_SITE_KEY=

# Server-only Vercel Function configuration.
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECOVERY_HMAC_SECRET=
SESSION_HMAC_SECRET=
IP_HASH_SALT=
SESSION_COOKIE_NAME=anonymous_session
SESSION_MAX_AGE_DAYS=180
APP_PUBLIC_URL=http://localhost:3000

# Test-only connection to an isolated, migrated Supabase database. Never use production.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Local Docker / Supabase (optional)
# Prefer: npm run db:start && npm run local:env
# The fixed HMAC secrets below must stay in sync with supabase/seed.sql demo hashes.
# -----------------------------------------------------------------------------
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<from: npx supabase status>
# RECOVERY_HMAC_SECRET=local-dev-recovery-hmac-secret-0001
# SESSION_HMAC_SECRET=local-dev-session-hmac-secret-00001
# IP_HASH_SALT=local-dev-ip-hash-salt-000000000001
# SESSION_COOKIE_NAME=anonymous_session
# SESSION_MAX_AGE_DAYS=180
# APP_PUBLIC_URL=http://localhost:3000
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Demo restore after seed: http://localhost:3000/#restore=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
