# Browser-visible. Optional local dev initData for testing outside Telegram WebView.
VITE_TELEGRAM_DEV_INIT_DATA=

# Server-only Vercel Function configuration.
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
APP_PUBLIC_URL=http://localhost:3000

# Test-only connection to an isolated, migrated Supabase database. Never use production.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Local Docker / Supabase (optional)
# Prefer: npm run db:start && npm run local:env
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=local-dev-telegram-bot-token-0000000001
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<from: npx supabase status>
# IP_HASH_SALT=local-dev-ip-hash-salt-000000000001
# APP_PUBLIC_URL=http://localhost:3000
# VITE_TELEGRAM_DEV_INIT_DATA=<generated by npm run local:env>
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
