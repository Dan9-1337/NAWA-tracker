# Browser-visible. Optional local dev initData for testing outside Telegram WebView.
VITE_TELEGRAM_DEV_INIT_DATA=
VITE_TELEGRAM_BOT_USERNAME=nawa_tracker_bot
# Support chat username (defaults to bot username when unset).
VITE_SUPPORT_TELEGRAM_USERNAME=

# Server-only Vercel Function configuration.
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret pepper for the pseudonymous account key (HMAC-SHA256 of the Telegram id). Min 32 chars.
# Generate: openssl rand -base64 32. Changing it orphans every stored profile.
IDENTITY_PEPPER=
# Secret for the Telegram webhook (sent back by Telegram as X-Telegram-Bot-Api-Secret-Token). Min 32 chars.
# Without it POST /api/bot answers 503.
TELEGRAM_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://localhost:3000
# Vercel Cron auth (production). Random secret, minimum 32 characters.
# Generate: openssl rand -base64 32
# Vercel sends Authorization: Bearer <CRON_SECRET> when invoking scheduled crons.
CRON_SECRET=

# Test-only connection to an isolated, migrated Supabase database. Never use production.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Local Docker / Supabase (optional)
# Prefer: npm run db:start && npm run local:env
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=local-dev-telegram-bot-token-0000000001
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<from: npx supabase status>
# IDENTITY_PEPPER=local-dev-identity-pepper-0000000001
# TELEGRAM_WEBHOOK_SECRET=local-dev-webhook-secret-00000000001
# APP_PUBLIC_URL=http://localhost:3000
# VITE_TELEGRAM_DEV_INIT_DATA=<generated by npm run local:env>
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
